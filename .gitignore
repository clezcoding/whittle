# ─────────────────────────────────────────────────────────────────────────────
# Whittle .gitignore
#
# Goal: nothing that is generated, local, personal, or stray ever reaches GitHub.
# This file is the first line of defence; `scripts/check-repo-hygiene.sh`
# (run by the pre-commit hook and CI) is the second: it fails on any tracked
# file outside the allow-listed top-level layout.
# ─────────────────────────────────────────────────────────────────────────────

# ── Rust / Cargo ─────────────────────────────────────────────────────────────
/target/
**/target/
**/*.rs.bk
*.pdb
# Cargo.lock IS committed (Whittle ships binaries).
# Coverage / profiling output
*.profraw
*.profdata
/coverage/
/lcov.info
cobertura.xml
tarpaulin-report.html
flamegraph.svg
perf.data*

# ── Node / pnpm / Vite (GUI) ─────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/
.npm/
package-lock.json
yarn.lock
apps/gui/dist/
apps/gui/dist-ssr/
apps/gui/.vite/
apps/gui/.cache/
apps/gui/.eslintcache
apps/gui/.parcel-cache/
*.tsbuildinfo
.turbo/

# ── Tauri ────────────────────────────────────────────────────────────────────
apps/gui/src-tauri/gen/
apps/gui/src-tauri/target/
apps/gui/src-tauri/WixTools/
# Signing material must never be committed
*.p12
*.pfx
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
tauri.key
tauri.key.pub
*.key
*.pem
*.p8
AuthKey_*.p8

# ── Build & release artifacts ────────────────────────────────────────────────
/dist/
/build/
/out/
/release/
/artifacts/
*.dmg
*.app/
*.pkg
*.msi
*.exe
*.AppImage
*.deb
*.rpm
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.tar.bz2
*.7z
*.rar
*.sha256
*.sha256sum
SHA256SUMS*
# Sparkle / updater signatures are generated in CI
*.sig

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.apdisk
# Finder's custom-icon file is named "Icon" + a carriage return. Do NOT write `Icon?`: on
# case-insensitive checkouts (macOS) it also matches the folder `icons/` and silently drops it.
Icon[\r]
*.icloud
__MACOSX/

# ── Windows / Linux leftovers (contributors on other OSes) ───────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.directory
.Trash-*
.nfs*

# ── Editors & IDEs ───────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.fleet/
.zed/
.helix/
.nova/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
\#*\#
.#*
*.orig
*.rej
*.bak
*.tmp
*.temp

# ── Environments & secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.secret
*.secrets
secrets.*
credentials*.json
service-account*.json
.netrc
.npmrc
.pypirc
*.gpg
id_rsa*
id_ed25519*
.envrc
.direnv/

# ── Logs, dumps, caches ──────────────────────────────────────────────────────
*.log
logs/
*.dump
*.core
core.[0-9]*
.cache/
.eslintcache
.stylelintcache
.sass-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ── Whittle runtime data (should never be in the repo) ───────────────────────
# Quarantine, journal and settings live in ~/.whittle and ~/.config/whittle.
# If someone runs with a repo-local --home or a test leaks data, keep it out.
.whittle/
/quarantine/
/journal.jsonl
/settings.json
/home/
/fixtures-home/

# ── Brand tooling output (re-generated by tools/brand/*.py) ──────────────────
tools/brand/__pycache__/
tools/brand/.venv/
tools/brand/out/
tools/brand/*.tmp.svg

# ── Scratch / personal / AI-tool leftovers ───────────────────────────────────
scratch/
tmp/
temp/
sandbox/
playground/
notes/
TODO.local*
*.local
*.local.*
.claude/
.claude-flow/
.cursor/
.cursorrules
.aider*
.continue/
.windsurf/
.copilot/
.codex/
.gemini/
CLAUDE.local.md
AGENTS.local.md
screenshots-tmp/
shots/
playwright-report/
test-results/
.playwright/
.playwright-mcp/

# ── Local-only convenience files ─────────────────────────────────────────────
# The double-click installer is tracked; user-made copies/variants are not.
*.command
!Install Whittle.command
*.copy
* copy.*
* (1).*
*-old.*
*-backup.*
*.old
